   │     │  │  │  │           /**
   │     │  │  │  │            * Calcula o valor liquido aplicando a taxa do KORVIL.
   │     │  │  │  │            */
   │     │  │  │  │           export function calcularValorLiquido(valorBruto) {
   │     │  │  │  │             const fee = env.repasse.feePercent / 100;
   │     │  │  │  │             const liquido = valorBruto * (1 - fee);
   │     │  │  │  │             return Number(liquido.toFixed(2));
   │     │  │  │  │           }
